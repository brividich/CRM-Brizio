<?xml version="1.0" encoding="UTF-8"?>
<!--
    web.config per Portale Novicrom — IIS + wfastcgi (ALTERNATIVA)
    =========================================================================
    ALTERNATIVA PIÙ SEMPLICE all'HttpPlatformHandler.
    wfastcgi è deprecato (ultimo aggiornamento 2019) ma ancora funzionante.

    PREREQUISITI:
      1. Attiva CGI nel ruolo IIS:
         Server Manager → Web Server → Application Development → CGI
      2. Installa wfastcgi nel venv:
         pip install wfastcgi
      3. Registra wfastcgi con IIS (da CMD admin):
         %%VENV_PATH%%\Scripts\wfastcgi-enable.exe
         Copia il percorso stampato (es. C:\...\python.exe|C:\...\wfastcgi.py)

    SEGNAPOSTO da sostituire manualmente:
      %%VENV_PATH%%      = C:\PortaleNovicrom\test\venv
      %%DJANGO_APP%%     = C:\PortaleNovicrom\test\current\django_app
      %%LOGS_PATH%%      = C:\PortaleNovicrom\test\logs
      %%SETTINGS_MOD%%   = config.settings.prod
      %%PYTHON_FASTCGI%% = percorso stampato da wfastcgi-enable, es:
                           C:\PortaleNovicrom\test\venv\Scripts\python.exe|C:\...\wfastcgi.py

    LIMITAZIONI rispetto a HttpPlatformHandler:
      - Nessun controllo sul processo Python (crash = 502)
      - Restart richiede recycle app pool manuale
      - Non supporta WebSocket
      - Thread model limitato
-->
<configuration>
  <appSettings>
    <add key="WSGI_HANDLER" value="config.wsgi.application" />
    <add key="WSGI_LOG"     value="%%LOGS_PATH%%\wfastcgi.log" />
    <add key="DJANGO_SETTINGS_MODULE" value="%%SETTINGS_MOD%%" />
    <add key="PYTHONPATH"   value="%%DJANGO_APP%%" />
    <add key="PYTHONUNBUFFERED" value="1" />
  </appSettings>

  <system.webServer>
    <handlers>
      <!-- Escludi /static/ e /media/ dall'handler Python -->
      <add name="StaticFiles"
           path="static/*"
           verb="GET,HEAD"
           modules="StaticFileModule"
           resourceType="File"
           preCondition="" />
      <add name="MediaFiles"
           path="media/*"
           verb="GET,HEAD"
           modules="StaticFileModule"
           resourceType="File"
           preCondition="" />
      <!-- Handler principale wfastcgi -->
      <add name="Python FastCGI"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="%%PYTHON_FASTCGI%%"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <location path="static">
    <system.webServer>
      <handlers>
        <clear />
        <add name="StaticFileHandler" path="*" verb="GET,HEAD"
             modules="StaticFileModule,DefaultDocumentModule" resourceType="Either" />
      </handlers>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="media">
    <system.webServer>
      <handlers>
        <clear />
        <add name="MediaFileHandler" path="*" verb="GET,HEAD"
             modules="StaticFileModule" resourceType="File" />
      </handlers>
      <!-- Audit 09/10 (A9): nessuno script dai file caricati (SVG/HTML). -->
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Security-Policy" />
          <add name="Content-Security-Policy" value="script-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="media/tickets">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- Documenti asset e allegati work order: solo view Django (token QR o
       sessione autenticata), mai URL diretto. L'asset_tag e' prevedibile. -->
  <location path="media/assets_documents">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <location path="media/assets_workorders">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- Allegati di modulo passati a storage privato (notizie, rentri, suggestion
       corner) e file storici del Diario Preposto: i vecchi file restano in
       /media/ ma si leggono SOLO dalle view Django protette. -->
  <location path="media/notizie">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/rentri">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/suggestion_corner">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/diario_preposto">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- GDPR 21/10/2026: cartelle legacy con dati personali (foto e documenti
       dipendenti, fotocard, firme e timbri, verbali e allegati task, file di import).
       I file nuovi nascono in media_private cifrato; quelli storici restano in
       /media/ finche' media_audit non li sposta, e si leggono SOLO da Django. -->
  <location path="media/anagrafica">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/firme">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/fotocard">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/timbri">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/tasks_vrf">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/tasks_attachments">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="media/attrezzature_import_preview">
    <system.webServer>
      <security>
        <requestFiltering>
          <denyUrlSequences>
            <add sequence="." />
          </denyUrlSequences>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- /media_private/ — MAI servita da IIS (difesa in profondita'). -->
  <location path="media_private">
    <system.webServer>
      <security>
        <authorization>
          <remove users="*" roles="" verbs="" />
          <add accessType="Deny" users="*" />
        </authorization>
      </security>
    </system.webServer>
  </location>
</configuration>
