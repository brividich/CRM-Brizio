# DJANGO_SECRET_KEY: lunghezza >= 50, no placeholder, no prefisso 'django-insecure-' in prod.
# Generare con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME
APP_VERSION=1.0.1
APP_VERSION_CORE=1.0.1
APP_VERSION_DASHBOARD=1.0.1
APP_VERSION_AI_ASSISTANT=1.0.1
APP_VERSION_ASSENZE=1.0.1
APP_VERSION_ANOMALIE=1.0.1
APP_VERSION_ASSETS=1.0.1
APP_VERSION_TASKS=1.0.1
APP_VERSION_ADMIN_PORTALE=1.0.1
APP_VERSION_NOTIZIE=1.0.1
APP_VERSION_ANAGRAFICA=1.0.1
APP_VERSION_TICKETS=1.0.1
APP_VERSION_DPI=1.0.1
APP_VERSION_PROCEDURE_REFRESH=1.0.1
DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS: in prod NO wildcard '*'. Elencare hostname esatti.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=sqlite
DB_HOST=sqlserver.example.local
DB_NAME=project_db
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=0
# Lasciare vuoto per default driver. Solo DEV/local SQLEXPRESS legacy: DB_ENCRYPT=0.
DB_ENCRYPT=

LEGACY_AUTH_ENABLED=1
NAVIGATION_REGISTRY_ENABLED=1
NAVIGATION_LEGACY_FALLBACK_ENABLED=0
ASSENZE_SYNC_ON_PAGE_LOAD=1
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=1
LEGACY_ACL_CACHE_TTL=120
LEGACY_NAV_CACHE_TTL=120

LDAP_ENABLED=0
LDAP_SERVER=ldap://ldap.example.local
LDAP_DOMAIN=EXAMPLE
LDAP_UPN_SUFFIX=@example.local
LDAP_TIMEOUT=5
LDAP_SERVICE_USER=svc_ldap@example.local
LDAP_SERVICE_PASSWORD=CHANGE_ME
LDAP_BASE_DN=DC=EXAMPLE,DC=LOCAL
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_GROUP_ALLOWLIST=EMPLOYEES,MANAGERS,ADMINS
LDAP_SYNC_PAGE_SIZE=500

GRAPH_TENANT_ID=<GRAPH_TENANT_ID>
GRAPH_CLIENT_ID=<GRAPH_CLIENT_ID>
GRAPH_CLIENT_SECRET=<GRAPH_CLIENT_SECRET>
GRAPH_SITE_ID=<GRAPH_SITE_ID>
GRAPH_LIST_ID_ASSENZE=<GRAPH_LIST_ID_ASSENZE>
GRAPH_LIST_ID_DIPENDENTI=<GRAPH_LIST_ID_DIPENDENTI>
GRAPH_LIST_ID_CAPOREPARTO=<GRAPH_LIST_ID_CAPOREPARTO>
GRAPH_LIST_ID_ANOMALIE_DB=<GRAPH_LIST_ID_ANOMALIE_DB>
GRAPH_LIST_ID_TIMBRI=<GRAPH_LIST_ID_TIMBRI>

ASSENZE_SP_PULL_INTERVAL_SECONDS=300
ASSENZE_CALENDAR_MAX_EVENTS=1500
ASSENZE_CALENDAR_COLORS_CACHE_TTL=300

# Assistente AI locale via Ollama.
# Se Ollama gira su una workstation dedicata, usare l'URL raggiungibile dal server Django.
OLLAMA_CHAT_ENABLED=1
OLLAMA_API_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1
OPENWEBUI_API_KEY=
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_CHAT_TEMPERATURE=0.2
OLLAMA_CHAT_MAX_PROMPT_CHARS=4000
OLLAMA_CHAT_MAX_HISTORY_MESSAGES=10
OLLAMA_RAG_ENABLED=1
# docs/ non e' nel pacchetto di deploy: la fonte RAG su file in prod e' README + la KB curata.
OLLAMA_RAG_SOURCE_PATHS=README.md,django_app/ai_assistant/knowledge
OLLAMA_RAG_MAX_CHUNKS=4
OLLAMA_RAG_MAX_CONTEXT_CHARS=5000
OLLAMA_RAG_CACHE_SECONDS=300
OLLAMA_RAG_MAX_DB_ENTRIES=200

EMAIL_HOST=smtp.example.local
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=portale@example.local

ANOMALIE_ATTACHMENTS_DIR=media\anomalie_allegati

# Archivio asset su SharePoint: percorso fisso "ASSET CN/<tag>/{manuali,specifiche,interventi}"
ASSETS_SHAREPOINT_LIBRARY_URL=

TIMBRI_FIELD_OPERATORE_LOOKUP=OperatoreLookupId
TIMBRI_FIELD_OPERATORE_LABEL=Operatore
TIMBRI_FIELD_MATRICOLA=Matricola
TIMBRI_FIELD_REPARTO=Operatore: Reparto
TIMBRI_FIELD_QUALIFICA=Qualifica
TIMBRI_FIELD_CODICE_TIMBRO=Timbro
TIMBRI_FIELD_DATA_CONSEGNA=Consegna Timbro
TIMBRI_FIELD_DATA_RITIRO=Data ritiro timbro
TIMBRI_FIELD_NOTE=Note
TIMBRI_FIELD_FIRMA_TESTO=Firma
TIMBRI_FIELD_ATTIVO=Attivo
TIMBRI_FIELD_TIPO_TIMBRO=Tipo timbro
TIMBRI_FIELD_IMAGE_1=URL Timbro1
TIMBRI_FIELD_IMAGE_2=URL Timbro2
TIMBRI_FIELD_IMAGE_3=URL Timbro3

GUESTPORTAL_URL=
GUESTPORTAL_FIELD_USERNAME=username
GUESTPORTAL_FIELD_PASSWORD=password
GUESTPORTAL_USERNAME_FORMAT=upn
