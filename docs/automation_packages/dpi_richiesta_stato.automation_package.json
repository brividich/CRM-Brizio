{
  "flow_name": "DPI - notifiche richiesta e cambio stato",
  "package_version": "1.0",
  "source_candidate": {
    "source_code": "dpi"
  },
  "approved_field_mapping": {
    "numero": "numero",
    "stato": "stato",
    "richiedente_nome": "richiedente_nome",
    "richiedente_email": "richiedente_email",
    "richiedente_reparto": "richiedente_reparto",
    "quantita": "quantita",
    "motivazione": "motivazione",
    "note_gestione": "note_gestione"
  },
  "compatibility": true,
  "issues": [],
  "proposed_rules": [
    {
      "code": "dpi-nuova-richiesta-notifica-gestori",
      "name": "Nuova richiesta DPI - notifica gestori",
      "description": "Avvisa i gestori DPI quando viene inserita una nuova richiesta in stato INVIATA.",
      "source_code": "dpi",
      "operation_type": "insert",
      "trigger_scope": "all_inserts",
      "stop_on_first_failure": false,
      "is_active": false,
      "is_draft": true,
      "conditions": [
        {
          "order": 1,
          "field_name": "stato",
          "operator": "equals",
          "expected_value": "INVIATA",
          "value_type": "string",
          "compare_with_old": false,
          "is_enabled": true
        }
      ],
      "actions": [
        {
          "order": 1,
          "action_type": "send_email",
          "description": "Email ai gestori DPI",
          "is_enabled": true,
          "config_json": {
            "from_email": "noreply@costruzioninovicrom.it",
            "to": "dpi@costruzioninovicrom.it",
            "subject_template": "[{numero}] Nuova richiesta DPI - {richiedente_nome}",
            "body_text_template": "Nuova richiesta DPI ricevuta.\n\nRichiedente: {richiedente_nome}\nReparto: {richiedente_reparto}\nQuantita: {quantita}\nMotivazione: {motivazione}\nStato: {stato}"
          }
        },
        {
          "order": 2,
          "action_type": "write_log",
          "description": "Log richiesta DPI",
          "is_enabled": true,
          "config_json": {
            "message_template": "Richiesta DPI {numero} notificata ai gestori."
          }
        }
      ]
    },
    {
      "code": "dpi-approvata-notifica-richiedente",
      "name": "Richiesta DPI approvata - notifica richiedente",
      "description": "Notifica il richiedente quando la richiesta passa ad APPROVATA.",
      "source_code": "dpi",
      "operation_type": "update",
      "trigger_scope": "specific_field",
      "watched_field": "stato",
      "stop_on_first_failure": false,
      "is_active": false,
      "is_draft": true,
      "conditions": [
        {
          "order": 1,
          "field_name": "stato",
          "operator": "changed_to",
          "expected_value": "APPROVATA",
          "value_type": "string",
          "compare_with_old": false,
          "is_enabled": true
        },
        {
          "order": 2,
          "field_name": "richiedente_email",
          "operator": "is_not_empty",
          "expected_value": "",
          "value_type": "string",
          "compare_with_old": false,
          "is_enabled": true
        }
      ],
      "actions": [
        {
          "order": 1,
          "action_type": "send_email",
          "description": "Email approvazione richiedente",
          "is_enabled": true,
          "config_json": {
            "from_email": "noreply@costruzioninovicrom.it",
            "to": "{richiedente_email}",
            "subject_template": "[{numero}] Richiesta DPI approvata",
            "body_text_template": "Ciao {richiedente_nome},\n\nla tua richiesta DPI {numero} e stata approvata.\n\nQuantita: {quantita}\nNote gestione: {note_gestione}\n\nSeguiranno indicazioni per la consegna."
          }
        },
        {
          "order": 2,
          "action_type": "write_log",
          "description": "Log DPI approvata",
          "is_enabled": true,
          "config_json": {
            "message_template": "Richiesta DPI {numero} approvata e notificata al richiedente."
          }
        }
      ]
    },
    {
      "code": "dpi-consegnata-notifica-richiedente",
      "name": "Richiesta DPI consegnata - notifica richiedente",
      "description": "Notifica il richiedente quando la richiesta passa a CONSEGNATA.",
      "source_code": "dpi",
      "operation_type": "update",
      "trigger_scope": "specific_field",
      "watched_field": "stato",
      "stop_on_first_failure": false,
      "is_active": false,
      "is_draft": true,
      "conditions": [
        {
          "order": 1,
          "field_name": "stato",
          "operator": "changed_to",
          "expected_value": "CONSEGNATA",
          "value_type": "string",
          "compare_with_old": false,
          "is_enabled": true
        },
        {
          "order": 2,
          "field_name": "richiedente_email",
          "operator": "is_not_empty",
          "expected_value": "",
          "value_type": "string",
          "compare_with_old": false,
          "is_enabled": true
        }
      ],
      "actions": [
        {
          "order": 1,
          "action_type": "send_email",
          "description": "Email consegna richiedente",
          "is_enabled": true,
          "config_json": {
            "from_email": "noreply@costruzioninovicrom.it",
            "to": "{richiedente_email}",
            "subject_template": "[{numero}] DPI consegnati",
            "body_text_template": "Ciao {richiedente_nome},\n\nla richiesta DPI {numero} risulta consegnata.\n\nGrazie."
          }
        },
        {
          "order": 2,
          "action_type": "write_log",
          "description": "Log DPI consegnata",
          "is_enabled": true,
          "config_json": {
            "message_template": "Richiesta DPI {numero} consegnata e notificata al richiedente."
          }
        }
      ]
    }
  ]
}
