<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="redirect.php" />
      </files>
    </defaultDocument>
    <!--
      Sicurezza 04/11/2026: IIS pubblica tutta la cartella Guestportal, ma via web
      servono solo public/, redirect.php e CN.ico. Le cartelle sotto contengono
      configurazione, credenziali, script, SQL e log: non devono essere scaricabili.
      I lavori pianificati leggono i file dal disco e non passano da qui.
      Copia del file precedente: C:\inetpub\guestportal_backup_20261104\web.config
    -->
    <security>
      <requestFiltering>
        <hiddenSegments applyToWebDAV="true">
          <add segment="scripts" />
          <add segment="sql" />
          <add segment="config" />
          <add segment="logs" />
          <add segment="storage" />
          <add segment="src" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
