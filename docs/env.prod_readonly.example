# Template per .env.prod_readonly — copiare nella RADICE del repo con quel nome.
#
#   copy docs\env.prod_readonly.example .env.prod_readonly
#
# Il file `.env.prod_readonly` e' ignorato da git (regola `.env.*`): NON committarlo,
# non incollarne il contenuto in chat, in log o in issue.
#
# Usato solo dal profilo di diagnosi in sola lettura:
#   python django_app\manage.py <comando> --settings=config.settings.prod_readonly
#
# L'utenza va creata con il SOLO ruolo db_datareader: vedi docs/prod_readonly_login.sql

PRODRO_DB_HOST=pclogsys
PRODRO_DB_NAME=PORTALE NOVICROM

# Login SQL dedicato in sola lettura. Lasciare USER e PASSWORD vuoti per usare
# l'autenticazione Windows dell'utente che lancia il comando: in quel caso i
# permessi sono quelli di quell'utente, quindi NON e' garantita la sola lettura
# lato server e resta attiva solo la barriera lato client.
PRODRO_DB_USER=hub_readonly
PRODRO_DB_PASSWORD=

PRODRO_DB_DRIVER=ODBC Driver 18 for SQL Server

# TrustServerCertificate: 1 solo se il certificato del server non e' verificabile
# dalla macchina di sviluppo. Preferire 0 e installare la CA.
PRODRO_DB_TRUST_CERT=0
PRODRO_DB_ENCRYPT=1
