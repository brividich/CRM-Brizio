# Golden glossario tecnico (fase B2): domande sintetiche su terminologia.
# "expect" = frammenti della fonte attesa (glossario:<id>#<termine-slug>), basta uno.
# Le domande usano apposta sinonimi, gergo, sigle e simboli invece del termine canonico.
{"q": "cos'è una lamatura?", "expect": ["#lamatura"]}
{"q": "cosa significa spot face sul disegno?", "expect": ["#lamatura"]}
{"q": "che vuol dire il simbolo ⌴ accanto al foro?", "expect": ["#lamatura"]}
{"q": "differenza tra planarità e parallelismo", "expect": ["#planarita", "#parallelismo"]}
{"q": "cosa indica H7 su una quota ⌀20 H7?", "expect": ["#campo-di-tolleranza", "#sistema-foro-base", "#grado-di-tolleranza"]}
