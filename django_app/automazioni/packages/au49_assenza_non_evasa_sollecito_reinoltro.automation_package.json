  "proposed_rules": [
    {
      "code": "au49-assenza-non-evasa-sollecito-reinoltro",
      "name": "AU49 - Approvazione assenza non evasa: sollecito + reinoltro HR",
      "description": "Alla creazione di una richiesta assenza (non già auto-approvata), invia una richiesta di approvazione al caporeparto; dopo ~24h, se la richiesta non risulta ancora approvata (run_if moderation_status non valorizzato come approvata), sollecita il caporeparto; dopo altre ~24h reinoltra ad HR. Usa send_approval + delay_schedule + run_if. NOTE/LIMITI: (1) il gate 'non evasa' usa moderation_status: VERIFICARE il valore numerico di 'approvata' nel sistema (qui si assume 0=pending; modificare l'operatore/valore in designer secondo la codifica reale). (2) i tempi 24h e i destinatari sono modificabili in designer (l'utente sceglierà l'inoltro). (3) Sostituire HR_DA_CONFIGURARE; per il caporeparto si usa {capo_email} dal payload.",
      "source_code": "assenze",
      "operation_type": "insert",
      "trigger_scope": "all_inserts",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "salta_approvazione",
          "operator": "is_false",
          "value": "",
          "value_type": "bool"
        }
      ],
      "actions": [
        {
          "action_type": "send_approval",
          "description": "Approvazione assenza al caporeparto",
          "delivery_mode": "email",
          "to_template": "{capo_email}",
          "subject_template": "[Assenze] Approvazione richiesta - {dipendente_nome}",
          "message_template": "Buongiorno,\n\ne' pervenuta una richiesta di assenza che richiede la sua approvazione.\n\nDettaglio richiesta assenza\nDipendente: {dipendente_nome}\nTipo: {tipo_assenza}\nDal: {data_inizio}\nAl: {data_fine}\nMotivazione: {motivazione_richiesta}\n\nAzione richiesta: approvare o respingere la richiesta.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "expiry_days": 3,
          "approve_label": "Approva",
          "reject_label": "Rifiuta",
          "approved_actions": [
            {
              "action_type": "send_email",
              "description": "Conferma al dipendente",
              "to": "{dipendente_email}",
              "subject_template": "[Assenze] Richiesta approvata",
              "body_text_template": "Gentile {dipendente_nome},\n\nla tua richiesta di assenza e' stata approvata.\n\nDettaglio richiesta assenza\nTipo: {tipo_assenza}\nDal: {data_inizio}\nAl: {data_fine}\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
              "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile {dipendente_nome},</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">la tua richiesta di assenza e' stata approvata.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Tipo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{tipo_assenza}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dal</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_inizio}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Al</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_fine}</td></tr></table></td></tr></table>",
              "email_type": "Automazioni",
              "section_label": "Assenze",
              "title_template": "Richiesta approvata"
            }
          ],
          "rejected_actions": [
            {
              "action_type": "send_email",
              "description": "Rifiuto al dipendente",
              "to": "{dipendente_email}",
              "subject_template": "[Assenze] Richiesta non approvata",
              "body_text_template": "Gentile {dipendente_nome},\n\nla tua richiesta di assenza non e' stata approvata.\n\nDettaglio richiesta assenza\nTipo: {tipo_assenza}\nDal: {data_inizio}\nAl: {data_fine}\n\nPer chiarimenti rivolgiti al tuo caporeparto.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
              "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile {dipendente_nome},</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">la tua richiesta di assenza non e' stata approvata.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Tipo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{tipo_assenza}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dal</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_inizio}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Al</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_fine}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Per chiarimenti rivolgiti al tuo caporeparto.</p>",
              "email_type": "Automazioni",
              "section_label": "Assenze",
              "title_template": "Richiesta non approvata"
            }
          ]
        },
        {
          "action_type": "delay_schedule",
          "description": "Attesa 24h prima del sollecito",
          "mode": "relative",
          "unit": "hours",
          "value_template": "24"
        },
        {
          "action_type": "send_email",
          "description": "Sollecito caporeparto se non evasa",
          "to": "{capo_email}",
          "subject_template": "[Assenze] SOLLECITO - richiesta di {dipendente_nome} in attesa",
          "body_text_template": "Buongiorno,\n\nla seguente richiesta di assenza risulta ancora in attesa della sua approvazione.\n\nDettaglio richiesta assenza\nDipendente: {dipendente_nome}\nTipo: {tipo_assenza}\nDal: {data_inizio}\nAl: {data_fine}\n\nAzione richiesta: evadere la richiesta quanto prima. In assenza di riscontro la pratica sara' reinoltrata a HR.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">la seguente richiesta di assenza risulta ancora in attesa della sua approvazione.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dipendente</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{dipendente_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Tipo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{tipo_assenza}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dal</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_inizio}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Al</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_fine}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: evadere la richiesta quanto prima. In assenza di riscontro la pratica sara' reinoltrata a HR.</p>",
          "email_type": "Automazioni",
          "section_label": "Assenze",
          "title_template": "SOLLECITO - richiesta di {dipendente_nome} in attesa",
          "run_if": {
            "field_name": "moderation_status",
            "operator": "equals",
            "value": "0",
            "value_type": "int"
          }
        },
        {
          "action_type": "delay_schedule",
          "description": "Attesa altre 24h prima del reinoltro HR",
          "mode": "relative",
          "unit": "hours",
          "value_template": "24"
        },
        {
          "action_type": "send_email",
          "description": "Reinoltro ad HR se ancora non evasa",
          "to": "HR_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Assenze] REINOLTRO HR - richiesta di {dipendente_nome} non evasa",
          "body_text_template": "Buongiorno,\n\nla seguente richiesta di assenza non e' stata evasa dal caporeparto entro i tempi previsti e viene reinoltrata a HR.\n\nDettaglio richiesta assenza\nDipendente: {dipendente_nome}\nTipo: {tipo_assenza}\nDal: {data_inizio}\nAl: {data_fine}\n\nAzione richiesta: gestire la pratica a cura dell'ufficio HR.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">la seguente richiesta di assenza non e' stata evasa dal caporeparto entro i tempi previsti e viene reinoltrata a HR.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dipendente</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{dipendente_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Tipo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{tipo_assenza}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dal</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_inizio}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Al</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_fine}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: gestire la pratica a cura dell'ufficio HR.</p>",
          "email_type": "Automazioni",
          "section_label": "Assenze",
          "title_template": "REINOLTRO HR - richiesta di {dipendente_nome} non evasa",
          "run_if": {
            "field_name": "moderation_status",
            "operator": "equals",
            "value": "0",
