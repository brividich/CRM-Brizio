{
  "package_version": "2026.05",
  "input": {
    "flow_name": "AU50 - Incidente (Accident) non chiuso: escalation normativa crescente"
  },
  "source_candidate": {
    "source_code": "rilevazione_incidenti",
    "label": "Incidenti / Sicurezza"
  },
  "compatibility": {
    "compatible": true,
    "status": "ok"
  },
  "issues": [],
  "target_context": {
    "module": "automazioni",
    "source": "rilevazione_incidenti"
  },
  "proposed_rules": [
    {
      "code": "au50-incidente-non-chiuso-escalation-normativa",
      "name": "AU50 - Incidente (Accident) non chiuso: escalation normativa crescente",
      "description": "Alla registrazione di un incidente di tipo Accident, avvia un'escalation normativa crescente sulla chiusura RSPP: a ~24h preposto, ~72h RSPP, ~7gg RLS+direzione, ognuno con run_if chiusura_rspp is_false (salta se nel frattempo l'RSPP ha chiuso). Usa delay_schedule + run_if a cascata. NOTE/LIMITI: (1) i tempi sono modificabili in designer. (2) il run_if rivaluta chiusura_rspp sul payload al momento dell'esecuzione differita. (3) Sostituire PREPOSTO/RSPP/RLS/DIREZIONE _DA_CONFIGURARE.",
      "source_code": "rilevazione_incidenti",
      "operation_type": "insert",
      "trigger_scope": "all_inserts",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "tipologia_scheda",
          "operator": "equals",
          "value": "Accident",
          "value_type": "string"
        }
      ],
      "actions": [
        {
          "action_type": "delay_schedule",
          "description": "Attesa 24h",
          "mode": "relative",
          "unit": "hours",
          "value_template": "24"
        },
        {
          "action_type": "send_email",
          "description": "L1 - Preposto se non chiuso",
          "to": "PREPOSTO_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Sicurezza] 24h - incidente non chiuso ({reparto})",
          "body_text_template": "Gentile preposto,\n\nun incidente registrato non risulta ancora chiuso dall'RSPP dopo 24 ore.\n\nDettaglio\nNominativo: {nominativo}\nReparto: {reparto}\nData: {data_segnalazione}\nTipologia: {tipologia_scheda}\n\nAzione richiesta: verificare lo stato di gestione dell'incidente e sollecitarne la chiusura.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile preposto,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">un incidente registrato non risulta ancora chiuso dall'RSPP dopo 24 ore.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Nominativo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{nominativo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Reparto</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{reparto}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Data</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_segnalazione}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Tipologia</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{tipologia_scheda}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: verificare lo stato di gestione dell'incidente e sollecitarne la chiusura.</p>",
          "email_type": "Automazioni",
          "section_label": "Sicurezza",
          "title_template": "24h - incidente non chiuso ({reparto})",
          "run_if": {
            "field_name": "chiusura_rspp",
            "operator": "is_false",
            "value_type": "bool"
          }
        },
        {
          "action_type": "delay_schedule",
          "description": "Attesa fino a 72h",
          "mode": "relative",
          "unit": "hours",
          "value_template": "48"
        },
        {
          "action_type": "send_email",
          "description": "L2 - RSPP se non chiuso",
          "to": "RSPP_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Sicurezza] 72h - incidente non chiuso ({reparto})",
          "body_text_template": "Gentile RSPP,\n\nun incidente registrato non risulta ancora chiuso dopo 72 ore.\n\nDettaglio\nNominativo: {nominativo}\nReparto: {reparto}\nData: {data_segnalazione}\nTipologia: {tipologia_scheda}\n\nAzione richiesta: procedere con la gestione e la chiusura dell'incidente con priorita'.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile RSPP,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">un incidente registrato non risulta ancora chiuso dopo 72 ore.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Nominativo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{nominativo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Reparto</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{reparto}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Data</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_segnalazione}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Tipologia</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{tipologia_scheda}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: procedere con la gestione e la chiusura dell'incidente con priorita'.</p>",
          "email_type": "Automazioni",
          "section_label": "Sicurezza",
          "title_template": "72h - incidente non chiuso ({reparto})",
          "run_if": {
            "field_name": "chiusura_rspp",
            "operator": "is_false",
            "value_type": "bool"
          }
        },
        {
          "action_type": "delay_schedule",
          "description": "Attesa fino a 7 giorni",
          "mode": "relative",
          "unit": "days",
          "value_template": "4"
        },
        {
          "action_type": "send_email",
          "description": "L3 - RLS + direzione se non chiuso",
          "to": "RLS_DA_CONFIGURARE@costruzioninovicrom.it",
          "cc": "DIREZIONE_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Sicurezza] 7gg - escalation RLS/direzione ({reparto})",
          "body_text_template": "Gentili RLS e direzione,\n\nun incidente registrato non risulta ancora chiuso dopo 7 giorni: si attiva l'escalation prevista.\n\nDettaglio\nNominativo: {nominativo}\nReparto: {reparto}\nData: {data_segnalazione}\nTipologia: {tipologia_scheda}\n\nAzione richiesta: prendere in carico la situazione e disporre le misure necessarie alla chiusura dell'incidente.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentili RLS e direzione,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">un incidente registrato non risulta ancora chiuso dopo 7 giorni: si attiva l'escalation prevista.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Nominativo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{nominativo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Reparto</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{reparto}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Data</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_segnalazione}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Tipologia</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{tipologia_scheda}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: prendere in carico la situazione e disporre le misure necessarie alla chiusura dell'incidente.</p>",
          "email_type": "Automazioni",
          "section_label": "Sicurezza",
          "title_template": "7gg - escalation RLS/direzione ({reparto})",
          "run_if": {
            "field_name": "chiusura_rspp",
            "operator": "is_false",
            "value_type": "bool"
          }
        }
      ]
    }
  ]
}
