{
  "package_version": "2026.05",
  "input": {
    "flow_name": "AU11 - Procedura scaduta non letta: escalation"
  },
  "source_candidate": {
    "source_code": "procedure_assegnazioni",
    "label": "Procedure - Assegnazioni"
  },
  "compatibility": {
    "compatible": true,
    "status": "ok"
  },
  "issues": [],
  "target_context": {
    "module": "automazioni",
    "source": "procedure_assegnazioni"
  },
  "proposed_rules": [
    {
      "code": "au11-procedura-overdue-escalation",
      "name": "AU11 - Procedura scaduta non letta: escalation",
      "description": "Quando un'assegnazione procedura passa a stato 'overdue', invia un sollecito; dopo 3 giorni, se la lettura non e' ancora confermata, esegue l'escalation al responsabile. Sostituire RESPONSABILE_DA_CONFIGURARE. NOTA: il primo invio usa l'email dell'utente assegnatario se disponibile nel payload; in mancanza, configurare un destinatario.",
      "source_code": "procedure_assegnazioni",
      "operation_type": "update",
      "trigger_scope": "specific_field",
      "watched_field": "status",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "status",
          "operator": "changed_to",
          "value": "overdue",
          "value_type": "string"
        }
      ],
      "actions": [
        {
          "action_type": "send_email",
          "description": "Sollecito immediato",
          "to": "UTENTE_O_RESPONSABILE_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Procedure] Sollecito presa visione scaduta - assegnazione #{id}",
          "body_text_template": "Gentile collega,\n\nrisulta una procedura assegnata la cui presa visione e' scaduta e non ancora confermata.\n\nDettaglio\nAssegnazione: #{id}\nStato: {status}\nScadenza: {due_date}\n\nAzione richiesta: accedere a NOVICROM HUB, aprire la procedura e confermare la lettura quanto prima.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile collega,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">risulta una procedura assegnata la cui presa visione e' scaduta e non ancora confermata.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Assegnazione</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{status}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Scadenza</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{due_date}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: accedere a NOVICROM HUB, aprire la procedura e confermare la lettura quanto prima.</p>",
          "email_type": "Automazioni",
          "section_label": "Procedure",
          "title_template": "Sollecito presa visione scaduta - assegnazione #{id}"
        },
        {
          "action_type": "delay_schedule",
          "description": "Attesa 3 giorni prima dell'escalation",
          "mode": "relative",
          "delay_value": 3,
          "delay_unit": "days"
        },
        {
          "action_type": "send_email",
          "description": "Escalation al responsabile se ancora non confermata",
          "to": "RESPONSABILE_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Procedure] Escalation: presa visione non confermata - assegnazione #{id}",
          "body_text_template": "Gentile responsabile,\n\nnonostante il sollecito inviato, l'assegnazione procedura indicata risulta ancora priva di conferma di lettura.\n\nDettaglio\nAssegnazione: #{id}\nStato: {status}\nScadenza: {due_date}\n\nAzione richiesta: verificare la situazione con l'assegnatario e assicurare il completamento della presa visione.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile responsabile,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">nonostante il sollecito inviato, l'assegnazione procedura indicata risulta ancora priva di conferma di lettura.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Assegnazione</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{status}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Scadenza</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{due_date}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: verificare la situazione con l'assegnatario e assicurare il completamento della presa visione.</p>",
          "email_type": "Automazioni",
          "section_label": "Procedure",
          "title_template": "Escalation: presa visione non confermata - assegnazione #{id}",
          "run_if": {
            "field_name": "read_confirmed_flag",
            "operator": "is_false",
            "value_type": "bool"
          }
        }
      ]
    }
  ]
}
