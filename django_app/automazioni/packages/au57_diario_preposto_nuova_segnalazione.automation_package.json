          "description": "Notifica nuova segnalazione a RSPP, preposti e RLS",
          "to": "rspp@costruzioninovicrom.it, preposti@costruzioninovicrom.it, rls@costruzioninovicrom.it",
          "subject_template": "[Sicurezza] Nuova segnalazione del preposto {codice_identificativo} - {titolo}",
