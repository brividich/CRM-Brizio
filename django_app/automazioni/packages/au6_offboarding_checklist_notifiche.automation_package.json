  "proposed_rules": [
    {
      "code": "au6-offboarding-checklist-notifiche",
      "name": "AU6 - Offboarding aperto: notifiche multi-ufficio",
      "description": "All'apertura di una pratica di offboarding invia le notifiche di checklist ai vari uffici: IT (revoca account/asset), magazzino (ritiro DPI), HR. VERSIONE FATTIBILE: usa send_email verso destinatari configurabili. NOTE/LIMITI: (1) la creazione automatica di un TICKET IT (come da backlog) richiede di aggiungere 'tickets_ticket' alla whitelist insert_record (AutomationTableConfig) - attualmente insert_record e' permesso SOLO su core_notifica. (2) Il for_each sui DPI del dipendente per il ritiro in massa richiede dati non presenti nel payload offboarding e validazione for_each non garantita dall'import package; rimandato. Sostituire i destinatari IT/MAGAZZINO/HR prima di attivare.",
      "source_code": "anagrafica_offboarding",
      "operation_type": "insert",
      "trigger_scope": "all_inserts",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [],
      "actions": [
        {
          "action_type": "send_email",
          "description": "Notifica IT revoca account e asset",
          "to": "IT_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Offboarding] Revoca account e asset IT - {dipendente_nome}",
          "body_text_template": "Buongiorno,\n\ne' stata aperta una pratica di offboarding che richiede l'intervento dell'ufficio IT.\n\nDettaglio offboarding\nDipendente: {dipendente_nome}\nReparto: {reparto}\nMansione: {mansione}\nMotivo: {motivo}\nUltimo giorno: {ultimo_giorno_operativo}\n\nAzione richiesta: procedere con la revoca degli account e il recupero degli asset IT assegnati al dipendente.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">e' stata aperta una pratica di offboarding che richiede l'intervento dell'ufficio IT.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dipendente</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{dipendente_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Reparto</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{reparto}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Mansione</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{mansione}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Motivo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{motivo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Ultimo giorno</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{ultimo_giorno_operativo}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: procedere con la revoca degli account e il recupero degli asset IT assegnati al dipendente.</p>",
          "email_type": "Automazioni",
          "section_label": "Offboarding",
          "title_template": "Revoca account e asset IT - {dipendente_nome}"
        },
        {
          "action_type": "send_email",
          "description": "Notifica magazzino ritiro DPI",
          "to": "MAGAZZINO_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Offboarding] Ritiro DPI - {dipendente_nome}",
          "body_text_template": "Buongiorno,\n\ne' stata aperta una pratica di offboarding che richiede l'intervento del magazzino.\n\nDettaglio offboarding\nDipendente: {dipendente_nome}\nReparto: {reparto}\nUltimo giorno: {ultimo_giorno_operativo}\n\nAzione richiesta: procedere con il ritiro dei DPI assegnati al dipendente.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">e' stata aperta una pratica di offboarding che richiede l'intervento del magazzino.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dipendente</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{dipendente_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Reparto</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{reparto}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Ultimo giorno</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{ultimo_giorno_operativo}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: procedere con il ritiro dei DPI assegnati al dipendente.</p>",
          "email_type": "Automazioni",
          "section_label": "Offboarding",
          "title_template": "Ritiro DPI - {dipendente_nome}"
        },
        {
          "action_type": "send_email",
          "description": "Promemoria HR",
          "to": "HR_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Offboarding] Checklist HR - {dipendente_nome}",
          "body_text_template": "Buongiorno,\n\ne' stata aperta una pratica di offboarding da gestire secondo la checklist HR.\n\nDettaglio offboarding\nDipendente: {dipendente_nome}\nReparto: {reparto}\nMansione: {mansione}\nMotivo: {motivo}\nCessazione prevista: {data_cessazione_prevista}\nUltimo giorno: {ultimo_giorno_operativo}\n\nAzione richiesta: avviare le attivita' HR di chiusura del rapporto.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">e' stata aperta una pratica di offboarding da gestire secondo la checklist HR.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dipendente</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{dipendente_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Reparto</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{reparto}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Mansione</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{mansione}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Motivo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{motivo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Cessazione prevista</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_cessazione_prevista}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Ultimo giorno</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{ultimo_giorno_operativo}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: avviare le attivita' HR di chiusura del rapporto.</p>",
          "email_type": "Automazioni",
          "section_label": "Offboarding",
          "title_template": "Checklist HR - {dipendente_nome}"
        }
      ]
    }
  ]
