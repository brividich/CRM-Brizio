  "proposed_rules": [
    {
      "code": "au43-anomalia-chiusa-conferma-autore",
      "name": "AU43 - Anomalia chiusa: conferma autore",
      "description": "Quando il flag 'chiudere' di un'anomalia passa a true (chiusura), invia una email di conferma. Configurare il destinatario in 'to' prima di attivare. Nota: il payload anomalie non espone l'email dell'autore; usare un destinatario fisso (es. responsabile qualita') finche' non e' disponibile (vedi AU-GAP1).",
      "source_code": "anomalie",
      "operation_type": "update",
      "trigger_scope": "specific_field",
      "watched_field": "chiudere",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "chiudere",
          "operator": "changed_to",
          "value": "true",
          "value_type": "bool"
        }
      ],
      "actions": [
        {
          "action_type": "send_email",
          "description": "Conferma chiusura anomalia",
          "to": "DESTINATARIO_DA_CONFIGURARE@costruzioninovicrom.it",
          "cc": "",
          "subject_template": "[Anomalie] Anomalia #{id} chiusa - OP {ex_op_nominativo}",
          "body_text_template": "Buongiorno,\n\nsi conferma la chiusura di un'anomalia.\n\nDettaglio\nRiferimento: #{id}\nOP: {ex_op_nominativo}\nPN / Seriale: {seriale}\nStato attuale: {avanzamento}\n\nNon sono richieste ulteriori azioni; il presente messaggio vale come conferma di avvenuta chiusura.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">si conferma la chiusura di un'anomalia.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Riferimento</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">OP</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{ex_op_nominativo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">PN / Seriale</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{seriale}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato attuale</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{avanzamento}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Non sono richieste ulteriori azioni; il presente messaggio vale come conferma di avvenuta chiusura.</p>",
          "email_type": "Automazioni",
          "section_label": "Anomalie",
          "title_template": "Anomalia #{id} chiusa - OP {ex_op_nominativo}"
        }
      ]
    }
  ]
