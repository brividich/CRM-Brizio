  "proposed_rules": [
    {
      "code": "au42-anomalia-avanzamento-cambiato-notifica",
      "name": "AU42 - Avanzamento anomalia cambiato: notifica",
      "description": "Quando lo stato (campo 'avanzamento') di un'anomalia cambia, invia una email di notifica. ATTENZIONE: notifica al cambio DEL CAMPO, non in base al ruolo di chi modifica. Per la versione 'solo quando CAPOCOMMESSA/CAR modificano' serve prima il prerequisito AU-GAP1 (esporre modified_by/ruolo nel payload anomalie). Configurare il destinatario in 'to' prima di attivare.",
      "source_code": "anomalie",
      "operation_type": "update",
      "trigger_scope": "specific_field",
      "watched_field": "avanzamento",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "avanzamento",
          "operator": "changed",
          "value": "",
          "value_type": "string"
        }
      ],
      "actions": [
        {
          "action_type": "send_email",
          "description": "Notifica cambio avanzamento anomalia",
          "to": "DESTINATARIO_DA_CONFIGURARE@costruzioninovicrom.it",
          "cc": "",
          "subject_template": "[Anomalie] Anomalia #{id} aggiornata - stato {avanzamento}",
          "body_text_template": "Buongiorno,\n\nlo stato di avanzamento di un'anomalia e' stato aggiornato.\n\nDettaglio\nRiferimento: #{id}\nOP: {ex_op_nominativo}\nPN / Seriale: {seriale}\nStato attuale: {avanzamento}\n\nSi invita a verificare l'aggiornamento nel portale e a procedere con le attivita' previste.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">lo stato di avanzamento di un'anomalia e' stato aggiornato.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Riferimento</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">OP</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{ex_op_nominativo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">PN / Seriale</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{seriale}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato attuale</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{avanzamento}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Si invita a verificare l'aggiornamento nel portale e a procedere con le attivita' previste.</p>",
          "email_type": "Automazioni",
          "section_label": "Anomalie",
          "title_template": "Anomalia #{id} aggiornata - stato {avanzamento}"
        }
      ]
    }
  ]
