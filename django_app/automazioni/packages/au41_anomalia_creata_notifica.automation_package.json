      "actions": [
        {
          "action_type": "send_email",
          "description": "Notifica creazione anomalia",
          "to": "DESTINATARIO_DA_CONFIGURARE@costruzioninovicrom.it",
          "cc": "",
          "subject_template": "[Anomalie] Nuova anomalia #{id} - OP {ex_op_nominativo}",
          "body_text_template": "Buongiorno,\n\ne' stata registrata una nuova anomalia che richiede la vostra attenzione.\n\nDettaglio\nRiferimento: #{id}\nOP: {ex_op_nominativo}\nPN / Seriale: {seriale}\nStato: {avanzamento}\n\nSi invita a verificare l'anomalia nel portale e a prendere in carico le attivita' di competenza.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">e' stata registrata una nuova anomalia che richiede la vostra attenzione.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Riferimento</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">OP</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{ex_op_nominativo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">PN / Seriale</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{seriale}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{avanzamento}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Si invita a verificare l'anomalia nel portale e a prendere in carico le attivita' di competenza.</p>",
          "email_type": "Automazioni",
          "section_label": "Anomalie",
          "title_template": "Nuova anomalia #{id} - OP {ex_op_nominativo}"
        }
