{
  "package_version": "2026.05",
  "input": {
    "flow_name": "AU13 - Ferie lunghe: doppia approvazione caporeparto poi HR"
  },
  "source_candidate": {
    "source_code": "assenze",
    "label": "Assenze"
  },
  "compatibility": {
    "compatible": true,
    "status": "ok"
  },
  "issues": [],
  "target_context": {
    "module": "automazioni",
    "source": "assenze"
  },
  "proposed_rules": [
    {
      "code": "au13-ferie-lunghe-doppia-approvazione",
      "name": "AU13 - Ferie lunghe: doppia approvazione caporeparto poi HR",
      "description": "Alla richiesta di ferie superiore a 10 giorni, avvia approvazione a cascata: prima il caporeparto ({capo_email}); se approva, l'approvazione passa a HR; solo se HR approva, il dipendente riceve la conferma. La durata >10gg e' verificata con l'operatore days_span_gt (data_inizio:10). La cascata usa send_approval annidate (ora supportate, max 3 livelli). Sostituire HR_DA_CONFIGURARE prima di attivare.",
      "source_code": "assenze",
      "operation_type": "insert",
      "trigger_scope": "all_inserts",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "tipo_assenza",
          "operator": "equals",
          "value": "ferie",
          "value_type": "string"
        },
        {
          "field": "data_fine",
          "operator": "days_span_gt",
          "value": "data_inizio:10",
          "value_type": "date"
        }
      ],
      "actions": [
        {
          "action_type": "send_approval",
          "description": "Approvazione livello 1: caporeparto",
          "delivery_mode": "email",
          "to_template": "{capo_email}",
          "subject_template": "[Ferie] Approvazione caporeparto - {dipendente_nome} (#{id})",
          "message_template": "Buongiorno,\n\ne' pervenuta una richiesta di ferie che richiede la sua approvazione come caporeparto.\n\nDettaglio richiesta ferie\nRichiesta (ID): {id}\nDipendente: {dipendente_nome}\nDal: {data_inizio}\nAl: {data_fine}\nMotivazione: {motivazione_richiesta}\n\nApprovando, la richiesta verra' inoltrata a HR per l'approvazione finale.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "expiry_days": 7,
          "approved_actions": [
            {
              "action_type": "send_approval",
              "description": "Approvazione livello 2: HR",
              "delivery_mode": "email",
              "to_template": "HR_DA_CONFIGURARE@costruzioninovicrom.it",
              "subject_template": "[Ferie] Approvazione finale HR - {dipendente_nome} (#{id})",
              "message_template": "Buongiorno,\n\nil caporeparto ha approvato una richiesta di ferie che ora richiede l'approvazione finale di HR.\n\nDettaglio richiesta ferie\nRichiesta (ID): {id}\nDipendente: {dipendente_nome}\nDal: {data_inizio}\nAl: {data_fine}\nMotivazione: {motivazione_richiesta}\n\nAzione richiesta: confermare o respingere la richiesta.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
              "expiry_days": 7,
              "approved_actions": [
                {
                  "action_type": "send_email",
                  "description": "Conferma ferie al dipendente",
                  "to": "{dipendente_email}",
                  "subject_template": "[Ferie] Richiesta approvata (#{id})",
                  "body_text_template": "Gentile {dipendente_nome},\n\nla tua richiesta di ferie e' stata approvata.\n\nDettaglio richiesta ferie\nRichiesta (ID): {id}\nDal: {data_inizio}\nAl: {data_fine}\n\nLa richiesta ha ottenuto l'approvazione del caporeparto e di HR.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
                  "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile {dipendente_nome},</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">la tua richiesta di ferie e' stata approvata.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Richiesta (ID)</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dal</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_inizio}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Al</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_fine}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">La richiesta ha ottenuto l'approvazione del caporeparto e di HR.</p>",
                  "email_type": "Automazioni",
                  "section_label": "Ferie",
                  "title_template": "Richiesta approvata (#{id})"
                }
              ],
              "rejected_actions": [
                {
                  "action_type": "send_email",
                  "description": "Rifiuto HR al dipendente",
                  "to": "{dipendente_email}",
                  "subject_template": "[Ferie] Richiesta non approvata (#{id})",
                  "body_text_template": "Gentile {dipendente_nome},\n\nla tua richiesta di ferie non e' stata approvata da HR.\n\nDettaglio richiesta ferie\nRichiesta (ID): {id}\nDal: {data_inizio}\nAl: {data_fine}\n\nPer chiarimenti rivolgiti all'ufficio HR.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
                  "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile {dipendente_nome},</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">la tua richiesta di ferie non e' stata approvata da HR.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Richiesta (ID)</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dal</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_inizio}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Al</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_fine}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Per chiarimenti rivolgiti all'ufficio HR.</p>",
                  "email_type": "Automazioni",
                  "section_label": "Ferie",
                  "title_template": "Richiesta non approvata (#{id})"
                }
              ]
            }
          ],
          "rejected_actions": [
            {
              "action_type": "send_email",
              "description": "Rifiuto caporeparto al dipendente",
              "to": "{dipendente_email}",
              "subject_template": "[Ferie] Richiesta non approvata (#{id})",
              "body_text_template": "Gentile {dipendente_nome},\n\nla tua richiesta di ferie non e' stata approvata dal caporeparto.\n\nDettaglio richiesta ferie\nRichiesta (ID): {id}\nDal: {data_inizio}\nAl: {data_fine}\n\nPer chiarimenti rivolgiti al tuo caporeparto.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
              "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile {dipendente_nome},</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">la tua richiesta di ferie non e' stata approvata dal caporeparto.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Richiesta (ID)</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dal</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_inizio}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Al</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_fine}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Per chiarimenti rivolgiti al tuo caporeparto.</p>",
              "email_type": "Automazioni",
              "section_label": "Ferie",
              "title_template": "Richiesta non approvata (#{id})"
            }
          ]
        }
      ]
    }
  ]
