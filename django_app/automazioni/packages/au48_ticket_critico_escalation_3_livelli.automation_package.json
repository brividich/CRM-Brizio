{
  "package_version": "2026.05",
  "input": {
    "flow_name": "AU48 - Ticket critico non preso in carico: escalation 3 livelli"
  },
  "source_candidate": {
    "source_code": "tickets",
    "label": "Tickets"
  },
  "compatibility": {
    "compatible": true,
    "status": "ok"
  },
  "issues": [],
  "target_context": {
    "module": "automazioni",
    "source": "tickets"
  },
  "proposed_rules": [
    {
      "code": "au48-ticket-critico-escalation-3-livelli",
      "name": "AU48 - Ticket critico non preso in carico: escalation 3 livelli",
      "description": "Quando viene aperto un ticket con priorita' CRITICA, avvia un'escalation a 3 livelli basata su delay_schedule + run_if sul campo data_presa_in_carico. L1: notifica immediata all'assegnatario. Dopo ~2h, se il ticket NON e' ancora stato preso in carico (data_presa_in_carico vuoto) -> L2 responsabile manutenzione. Dopo altre ~2h, se ancora non preso in carico -> L3 direzione. NOTE/LIMITI: (1) i tempi (2h) e i destinatari sono placeholder: modificabili in designer. (2) il run_if di ogni livello rivaluta il campo data_presa_in_carico sul payload al momento dell'esecuzione differita; il delay_schedule re-incoda l'evento. (3) Sostituire ASSEGNATARIO/RESP_MANUTENZIONE/DIREZIONE _DA_CONFIGURARE; in alternativa usare {assegnato_email} per L1.",
      "source_code": "tickets",
      "operation_type": "insert",
      "trigger_scope": "all_inserts",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "priorita",
          "operator": "equals",
          "value": "CRITICA",
          "value_type": "string"
        }
      ],
      "actions": [
        {
          "action_type": "send_email",
          "description": "L1 - Notifica immediata assegnatario",
          "to": "ASSEGNATARIO_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Ticket critico] Presa in carico richiesta - {numero_ticket}",
          "body_text_template": "Gentile assegnatario,\n\ne' stato aperto un ticket con priorita' CRITICA che richiede presa in carico immediata.\n\nDettaglio\nRiferimento: #{id} ({numero_ticket})\nTitolo: {titolo}\nAsset: {asset_nome}\nPriorita': {priorita}\nStato: {stato}\n\nApri nel portale: {object_url}\n\nSi prega di prendere in carico il ticket al piu' presto.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile assegnatario,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">e' stato aperto un ticket con priorita' CRITICA che richiede presa in carico immediata.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Riferimento</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id} ({numero_ticket})</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Titolo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{titolo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Asset</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{asset_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Priorita'</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{priorita}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{stato}</td></tr></table></td></tr></table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:4px 0 18px;\"><tr><td style=\"border-radius:8px;background:#002b5c;\"><a href=\"{object_url}\" style=\"display:inline-block;padding:12px 26px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:8px;\">Apri nel portale &rarr;</a></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Si prega di prendere in carico il ticket al piu' presto.</p>",
          "email_type": "Automazioni",
          "section_label": "Ticket critico",
          "title_template": "Presa in carico richiesta - {numero_ticket}"
        },
        {
          "action_type": "delay_schedule",
          "description": "Attesa L1->L2 (~2 ore)",
          "mode": "relative",
          "unit": "hours",
          "value_template": "2"
        },
        {
          "action_type": "send_email",
          "description": "L2 - Escalation responsabile manutenzione se non preso in carico",
          "to": "RESP_MANUTENZIONE_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Escalation L2] Ticket critico {numero_ticket} non preso in carico",
          "body_text_template": "Gentile Responsabile Manutenzione,\n\nil seguente ticket con priorita' CRITICA non risulta ancora preso in carico ed e' stato escalato al secondo livello.\n\nDettaglio\nRiferimento: #{id} ({numero_ticket})\nTitolo: {titolo}\nAsset: {asset_nome}\nPriorita': {priorita}\nStato: {stato}\n\nApri nel portale: {object_url}\n\nSi richiede un intervento per assegnare e prendere in carico il ticket.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile Responsabile Manutenzione,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">il seguente ticket con priorita' CRITICA non risulta ancora preso in carico ed e' stato escalato al secondo livello.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Riferimento</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id} ({numero_ticket})</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Titolo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{titolo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Asset</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{asset_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Priorita'</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{priorita}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{stato}</td></tr></table></td></tr></table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:4px 0 18px;\"><tr><td style=\"border-radius:8px;background:#002b5c;\"><a href=\"{object_url}\" style=\"display:inline-block;padding:12px 26px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:8px;\">Apri nel portale &rarr;</a></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Si richiede un intervento per assegnare e prendere in carico il ticket.</p>",
          "email_type": "Automazioni",
          "section_label": "Escalation L2",
          "title_template": "Ticket critico {numero_ticket} non preso in carico",
          "run_if": {
            "field_name": "data_presa_in_carico",
            "operator": "is_empty",
            "value_type": "datetime"
          }
        },
        {
          "action_type": "delay_schedule",
          "description": "Attesa L2->L3 (~2 ore)",
          "mode": "relative",
          "unit": "hours",
          "value_template": "2"
        },
        {
          "action_type": "send_email",
          "description": "L3 - Escalation direzione se ancora non preso in carico",
          "to": "DIREZIONE_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Escalation L3] Ticket critico {numero_ticket} ancora fermo",
          "body_text_template": "Gentile Direzione,\n\nil seguente ticket con priorita' CRITICA non e' stato preso in carico dopo due livelli di sollecito ed e' stato escalato al terzo livello.\n\nDettaglio\nRiferimento: #{id} ({numero_ticket})\nTitolo: {titolo}\nAsset: {asset_nome}\nPriorita': {priorita}\nStato: {stato}\n\nApri nel portale: {object_url}\n\nSi richiede l'intervento della direzione per la gestione del ticket.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Gentile Direzione,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">il seguente ticket con priorita' CRITICA non e' stato preso in carico dopo due livelli di sollecito ed e' stato escalato al terzo livello.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Riferimento</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">#{id} ({numero_ticket})</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Titolo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{titolo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Asset</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{asset_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Priorita'</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{priorita}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Stato</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{stato}</td></tr></table></td></tr></table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:4px 0 18px;\"><tr><td style=\"border-radius:8px;background:#002b5c;\"><a href=\"{object_url}\" style=\"display:inline-block;padding:12px 26px;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;border-radius:8px;\">Apri nel portale &rarr;</a></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Si richiede l'intervento della direzione per la gestione del ticket.</p>",
          "email_type": "Automazioni",
          "section_label": "Escalation L3",
          "title_template": "Ticket critico {numero_ticket} ancora fermo",
          "run_if": {
            "field_name": "data_presa_in_carico",
            "operator": "is_empty",
            "value_type": "datetime"
          }
        }
      ]
    }
  ]
}
