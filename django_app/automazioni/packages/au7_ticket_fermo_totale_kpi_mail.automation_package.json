{
  "package_version": "2026.05",
  "input": {
    "flow_name": "AU7 - Ticket fermo TOTALE: KPI ore fermo + mail"
  },
  "source_candidate": {
    "source_code": "tickets",
    "label": "Tickets"
  },
  "compatibility": {
    "compatible": true,
    "status": "ok"
  },
  "issues": [],
  "target_context": {
    "module": "automazioni",
    "source": "tickets"
  },
  "proposed_rules": [
    {
      "code": "au7-ticket-fermo-totale-kpi-mail",
      "name": "AU7 - Ticket fermo TOTALE: KPI ore fermo + mail",
      "description": "Quando un ticket passa a fermo TOTALE (tipo_fermo changed_to TOTALE) aggiorna il KPI dashboard delle ore di fermo macchina e invia la consueta mail di ticket ai referenti manutenzione (da feedback utente: SOLO KPI + mail ticket standard, nessun blocco). NOTE/LIMITI: (1) il codice metrica 'ore_fermo_macchina' deve esistere/essere creato nella configurazione dashboard; {ore_fermo_macchina} vale 0 se non valorizzato sul ticket. (2) Sostituire MANUTENZIONE_DA_CONFIGURARE prima di attivare.",
      "source_code": "tickets",
      "operation_type": "update",
      "trigger_scope": "specific_field",
      "watched_field": "tipo_fermo",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "tipo_fermo",
          "operator": "changed_to",
          "value": "TOTALE",
          "value_type": "string"
        }
      ],
      "actions": [
        {
          "action_type": "update_dashboard_metric",
          "description": "Somma ore di fermo macchina al KPI ore fermo",
          "metric_code": "ore_fermo_macchina",
          "operation": "increment",
          "value_template": "{ore_fermo_macchina}"
        },
        {
          "action_type": "send_email",
          "description": "Mail ticket standard - fermo totale",
          "to": "MANUTENZIONE_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Ticket {numero_ticket}] Fermo TOTALE - {asset_nome}",
          "body_text_template": "Buongiorno,\n\nil ticket sotto riportato e' passato a fermo macchina TOTALE.\n\nDettaglio ticket\nNumero: {numero_ticket}\nTitolo: {titolo}\nAsset: {asset_nome}\nPriorita': {priorita}\nOre fermo macchina: {ore_fermo_macchina}\nAssegnato a: {assegnato_a}\n\nAzione richiesta: dare priorita' all'intervento per ridurre il fermo produzione.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">il ticket sotto riportato e' passato a fermo macchina <strong>TOTALE</strong>.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Numero</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{numero_ticket}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Titolo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{titolo}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Asset</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{asset_nome}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Priorita'</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{priorita}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Ore fermo</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{ore_fermo_macchina}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: dare priorita' all'intervento per ridurre il fermo produzione.</p>",
          "email_type": "Automazioni",
          "section_label": "Ticket",
          "title_template": "Fermo TOTALE - ticket {numero_ticket}"
        }
      ]
    }
  ]
}
