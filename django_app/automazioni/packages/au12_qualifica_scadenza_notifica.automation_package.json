{
  "package_version": "2026.05",
  "input": {
    "flow_name": "AU12 - Qualifica in scadenza: notifica HR preventiva"
  },
  "source_candidate": {
    "source_code": "anagrafica_qualifiche",
    "label": "Anagrafica - Qualifiche dipendenti"
  },
  "compatibility": {
    "compatible": true,
    "status": "ok"
  },
  "issues": [],
  "target_context": {
    "module": "automazioni",
    "source": "anagrafica_qualifiche"
  },
  "proposed_rules": [
    {
      "code": "au12-qualifica-scadenza-notifica",
      "name": "AU12 - Qualifica in scadenza: notifica HR preventiva",
      "description": "Quando una qualifica viene inserita o aggiornata con data_scadenza entro 60 giorni, notifica HR per pianificare il rinnovo. Usa il nuovo operatore days_from_now_lte. NOTA: per intercettare le scadenze che 'maturano' nel tempo (senza modifica del record) serve un job schedulato che rivaluti le qualifiche; questa regola scatta sugli insert/update del record qualifica. Sostituire HR_DA_CONFIGURARE.",
      "source_code": "anagrafica_qualifiche",
      "operation_type": "insert",
      "trigger_scope": "all_inserts",
      "is_active": false,
      "is_draft": true,
      "stop_on_first_failure": false,
      "conditions": [
        {
          "field": "data_scadenza",
          "operator": "days_from_now_lte",
          "value": "60",
          "value_type": "date"
        },
        {
          "field": "data_scadenza",
          "operator": "is_not_empty",
          "value": "",
          "value_type": "date"
        }
      ],
      "actions": [
        {
          "action_type": "send_email",
          "description": "Notifica HR rinnovo qualifica",
          "to": "HR_DA_CONFIGURARE@costruzioninovicrom.it",
          "subject_template": "[Formazione] Qualifica in scadenza - dipendente {legacy_anagrafica_id}",
          "body_text_template": "Buongiorno,\n\nuna qualifica del personale risulta in prossima scadenza.\n\nDettaglio qualifica\nQualifica (ID): {id}\nDipendente (ID): {legacy_anagrafica_id}\nData scadenza: {data_scadenza}\n\nAzione richiesta: pianificare per tempo il rinnovo della qualifica.\n\nQuesto messaggio e' generato automaticamente da NOVICROM HUB.",
          "body_html_template": "<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">Buongiorno,</p>\n<p style=\"margin:0 0 14px;color:#475569;font-size:15px;line-height:1.65;\">una qualifica del personale risulta in prossima scadenza.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;background:#f6f9fc;border:1px solid #d8e1ec;border-left:4px solid #ff6b00;border-radius:10px;margin:0 0 16px;\"><tr><td style=\"padding:6px 16px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Qualifica (ID)</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Dipendente (ID)</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{legacy_anagrafica_id}</td></tr><tr><td style=\"padding:7px 14px 7px 0;color:#64748b;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;\">Data scadenza</td><td style=\"padding:7px 0;color:#182232;font-size:14px;line-height:1.5;vertical-align:top;\">{data_scadenza}</td></tr></table></td></tr></table>\n<p style=\"margin:0 0 12px;color:#475569;font-size:15px;line-height:1.65;\">Azione richiesta: pianificare per tempo il rinnovo della qualifica.</p>",
          "email_type": "Automazioni",
          "section_label": "Formazione",
          "title_template": "Qualifica in scadenza - dipendente {legacy_anagrafica_id}"
        }
      ]
    }
  ]
}
