# ── Setup Wizard ──────────────────────────────────────────────────────────────
# Impostare a 1 dopo aver completato il wizard di configurazione.
# Se 0 o assente, ogni richiesta viene reindirizzata a /setup/.
SETUP_COMPLETED=0

# ── Branding istanza ──────────────────────────────────────────────────────────
# Nome visualizzato agli utenti. Usa "NOVICROM HUB" come baseline e personalizzalo
# solo se serve una etichetta diversa per una singola installazione.
INSTANCE_NAME=NOVICROM HUB
BRANDING_LOGO=
BRANDING_FAVICON=

# ── Applicazione ──────────────────────────────────────────────────────────────
# DJANGO_SECRET_KEY (obbligatoria in prod):
# - lunghezza minima richiesta da validate_deployment: 50 caratteri
# - non lasciare placeholder (CHANGE_ME, change-me-in-dev, ecc.)
# - non usare il prefisso 'django-insecure-' (default startproject) in prod
# - generare con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME
APP_VERSION=1.0.1
APP_VERSION_CORE=1.0.1
APP_VERSION_DASHBOARD=1.0.1
APP_VERSION_ASSENZE=1.0.1
APP_VERSION_ANOMALIE=1.0.1
APP_VERSION_ASSETS=1.0.1
APP_VERSION_TASKS=1.0.1
APP_VERSION_ADMIN_PORTALE=1.0.1
APP_VERSION_NOTIZIE=1.0.1
APP_VERSION_ANAGRAFICA=1.0.1
APP_VERSION_TICKETS=1.0.1
APP_VERSION_DPI=1.0.1
APP_VERSION_PROCEDURE_REFRESH=1.0.1
DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS: in prod NON usare '*' (host header poisoning).
# Elencare esplicitamente FQDN e IP del server (separati da virgola).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS: lista CSV https://hostname (no wildcard).
# Esempio prod: https://hub.example.local,https://hub-proxy.msappproxy.net
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Impostare a 0 se il server è raggiungibile solo via HTTP (rete interna senza TLS).
# In produzione con HTTPS impostare tutti e 3 a 1 (validate_deployment FAIL altrimenti).
SECURE_SSL_REDIRECT=0
CSRF_COOKIE_SECURE=0
SESSION_COOKIE_SECURE=0

DB_ENGINE=sqlite
DB_HOST=sqlserver.example.local
DB_NAME=project_db
DB_USER=
DB_PASSWORD=
# In deploy IIS il wizard allinea automaticamente questo valore al miglior driver SQL Server installato.
DB_DRIVER=ODBC Driver 18 for SQL Server
# Impostare a 1 solo in sviluppo con certificati self-signed. In produzione lasciare 0.
DB_TRUST_CERT=0
# Lasciare vuoto per il default del driver. Solo in sviluppo locale con SQLEXPRESS legacy usare 0.
DB_ENCRYPT=

LEGACY_AUTH_ENABLED=1
NAVIGATION_REGISTRY_ENABLED=1
NAVIGATION_LEGACY_FALLBACK_ENABLED=0
ASSENZE_SYNC_ON_PAGE_LOAD=0
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=1
LEGACY_ACL_CACHE_TTL=120
LEGACY_NAV_CACHE_TTL=120
# ACL v2 governance migrazione legacy→canonico:
# ACL_LOG_LEGACY_FALLBACK=1 emette warning throttled per ogni route risolta
# via fallback legacy (anche in allow) — utile per auditare l'uso residuo.
# ACL_STRICT_CANONICAL=1 nega le route senza RoutePermissionBinding canonico
# anche se il legacy le consentirebbe. Attivare prima in test/UAT.
ACL_LOG_LEGACY_FALLBACK=1
ACL_STRICT_CANONICAL=0

LDAP_ENABLED=0
LDAP_SERVER=ldap://ldap.example.local
LDAP_DOMAIN=EXAMPLE
LDAP_UPN_SUFFIX=@example.local
LDAP_TIMEOUT=5
LDAP_SERVICE_USER=svc_ldap@example.local
LDAP_SERVICE_PASSWORD=CHANGE_ME
LDAP_BASE_DN=DC=EXAMPLE,DC=LOCAL
LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user))
LDAP_GROUP_ALLOWLIST=EMPLOYEES,MANAGERS,ADMINS
LDAP_SYNC_PAGE_SIZE=500
# Windows SSO/SPNEGO. Vuoto = usa l'hostname della richiesta (es. testhub.cnovicrom.local).
WINDOWS_SSO_HOSTNAME=
WINDOWS_SSO_SERVICE=HTTP

GRAPH_TENANT_ID=<GRAPH_TENANT_ID>
GRAPH_CLIENT_ID=<GRAPH_CLIENT_ID>
GRAPH_CLIENT_SECRET=<GRAPH_CLIENT_SECRET>
GRAPH_SITE_ID=<GRAPH_SITE_ID>
GRAPH_LIST_ID_ASSENZE=<GRAPH_LIST_ID_ASSENZE>
GRAPH_LIST_ID_DIPENDENTI=<GRAPH_LIST_ID_DIPENDENTI>
GRAPH_LIST_ID_CAPOREPARTO=<GRAPH_LIST_ID_CAPOREPARTO>
GRAPH_LIST_ID_ANOMALIE_DB=<GRAPH_LIST_ID_ANOMALIE_DB>
GRAPH_LIST_ID_RENTRI=<GRAPH_LIST_ID_RENTRI>

ASSENZE_SP_PULL_INTERVAL_SECONDS=300
ASSENZE_CALENDAR_MAX_EVENTS=1500
ASSENZE_CALENDAR_COLORS_CACHE_TTL=300

# Liveness/readiness probe (monitoring/health.py)
# IP autorizzati a chiamare /healthz e /readyz. Default: solo loopback.
# Aggiungere l'IP del proxy IIS / load balancer / Application Proxy.
HEALTHZ_ALLOWED_IPS=127.0.0.1,::1
# Memoizzazione del risultato di /readyz (secondi) per evitare DoS sulle integrazioni.
# 0 = nessuna cache (utile in test/debugging).
READYZ_TTL_SECONDS=10
# Sottoinsieme di check da eseguire (CSV). Vuoto = tutti.
# Disponibili: db_default, db_legacy, cache, graph_token, ldap, smtp, automation_queue.
READYZ_CHECKS_ENABLED=

# DJANGO_LOG_DIR (OBBLIGATORIA in prod, opzionale in dev/test).
# In prod base.py solleva ImproperlyConfigured se manca: nessun fallback su temp.
# SQL query logging (utile in sviluppo, disabilitare in produzione)
DJANGO_LOG_DIR=logs
SQL_LOG_ENABLED=0
SQL_LOG_LEVEL=DEBUG
SQL_LOG_FORCE_DEBUG_CURSOR=0
SQL_LOG_MAX_BYTES=10485760
SQL_LOG_BACKUP_COUNT=10

# Storage privato: non pubblicare queste directory via web server.
# IMPORTANTE: ASSETS_PRIVATE_ROOT/TICKETS_PRIVATE_ROOT NON devono essere
# contenute in MEDIA_ROOT (validate_deployment esegue path containment check).
ASSETS_PRIVATE_ROOT=media_private
TICKETS_PRIVATE_ROOT=media_private

# Trigger generator: applicazione diretta al DB disabilitata per default.
# WARN in prod se attivato (apply DDL diretta = privilegio elevato).
AUTOMAZIONI_TRIGGER_DB_APPLY_ENABLED=0

# SMTP (usato dal modulo Automazioni per azioni SEND_EMAIL)
EMAIL_HOST=smtp.example.local
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=portale@example.local
# URL base del portale nei link email approvazioni. Vuoto = link relativi.
# Entra Application Proxy: impostare all'URL esterno (es. https://approvazioni-xxx.msappproxy.net)
SITE_URL=

# ── Polling mailbox approvazioni mail_reply / hybrid ─────────────────────────
# Backend: 'graph' (default, Modern Auth M365) oppure 'imap' (Basic Auth, legacy)
APPROVAL_MAILBOX_BACKEND=graph

# Graph mailbox (usato da: python manage.py process_approval_mailbox)
# Richiede app registration Entra ID con Mail.ReadWrite Application permission + Admin Consent
# Le credenziali Graph (GRAPH_TENANT_ID, GRAPH_CLIENT_ID, GRAPH_CLIENT_SECRET) sono condivise
APPROVAL_MAILBOX_ADDRESS=approvals@example.local
APPROVAL_MAILBOX_FOLDER=Inbox
APPROVAL_GRAPH_ONLY_UNREAD=1
APPROVAL_GRAPH_PAGE_SIZE=25
APPROVAL_GRAPH_MARK_READ=1

# IMAP polling (legacy — non funziona su Microsoft 365 con Basic Auth bloccata)
# Usare solo con server IMAP classici che supportano Basic Auth
# Usato da: python manage.py poll_approval_mailbox
APPROVAL_IMAP_HOST=
APPROVAL_IMAP_PORT=993
APPROVAL_IMAP_USER=
APPROVAL_IMAP_PASSWORD=
APPROVAL_IMAP_SSL=1
APPROVAL_IMAP_FOLDER=INBOX

