# Copia come collector.env accanto a machines.json (resta sul PC, mai nel repository).
# Lo script avvia_collector.ps1 lo carica all'avvio; i valori non compaiono mai nel log.
# Password OPC UA delle macchine che non accettano l'accesso anonimo (machines.json: "password_env").
CNC_DM7_PASSWORD=
# Libreria Fanuc (file o cartella con Fwlib64.dll / libfwlib32.so).
CNC_FWLIB_PATH=
